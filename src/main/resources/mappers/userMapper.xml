<?xml version="1.0" encoding="UTF-8"?> 

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.andy.memo.user.repository.UserRepository">

	<insert id="insertUser" parameterType="map">
		INSERT INTO
		`user`
		(
		`loginId`
		,`email`
		,`password`
		,`name`
		)
		VALUES
		(
		#{loginId}
		, #{email}
		,
		#{password}
		, #{name}
		)
	</insert>

	<select id="selectCountByloginId" parameterType="string"
		resultType="int">
		SELECT
		count(*)
		FROM
		`user`
		WHERE
		`loginId` = #{loginId}
	</select>

	<select id="selectUser" parameterType="map"
		resultType="com.andy.memo.user.domain.User">
		SELECT
		`id`
		`loginId`
		,`email`
		,`password`
		,`name`
		,`createdAt`
		,`updatedAt`
		FROM
		`user`
		WHERE
		`loginId` = #{loginId}
		AND
		`password` =
		#{password}

	</select>

</mapper>